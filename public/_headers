# Cloudflare Pages / Netlify header rules.
# Copied verbatim into the build output.

# Next.js fingerprints these filenames, so they can never go stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Course data is regenerated by the scraper twice a month. Serve from cache for
# an hour, then revalidate in the background so a refresh is never blocking.
/data/index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/terms/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# HTML is small and cheap to revalidate; always check for a new deploy.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
